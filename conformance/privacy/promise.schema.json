{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/privacy/promise/v1.json",
  "title": "PrivacyPromise",
  "description": "A versioned privacy promise: which data, for which purpose, where and by whom it is processed, as tuples, with Turkish and English text. `digest` is the SHA-256 of the RFC 8785 (JCS) form of the promise without `digest`. A version that widens the previous one declares its notice and its re-consent flag. PV-19, INV-26, PV-6, Access E60.",
  "type": "object",
  "required": ["version", "url", "effective_at", "tuples", "text", "change", "digest"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "url": { "type": "string", "pattern": "^https://suiss\\.app/one/privacy/promise/v[1-9][0-9]*$" },
    "effective_at": { "$ref": "#/$defs/instant" },
    "tuples": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tuple" }
    },
    "text": {
      "type": "object",
      "required": ["tr", "en"],
      "additionalProperties": false,
      "properties": {
        "tr": { "$ref": "#/$defs/lines" },
        "en": { "$ref": "#/$defs/lines" }
      }
    },
    "change": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["from_version", "classification"],
          "additionalProperties": false,
          "properties": {
            "from_version": { "type": "integer", "minimum": 1 },
            "classification": { "enum": ["equal", "narrowing", "widening"] },
            "notice_at": { "$ref": "#/$defs/instant" },
            "reconsent": { "type": "boolean" }
          },
          "if": { "properties": { "classification": { "const": "widening" } } },
          "then": { "required": ["notice_at", "reconsent"] }
        }
      ]
    },
    "digest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" }
  },
  "if": { "properties": { "version": { "const": 1 } } },
  "then": { "properties": { "change": { "type": "null" } } },
  "else": { "properties": { "change": { "type": "object" } } },
  "$defs": {
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
    "tuple": {
      "type": "object",
      "required": ["category", "purpose", "location", "accessor", "consent"],
      "additionalProperties": false,
      "properties": {
        "category": { "enum": ["memory", "episodes", "personality", "personal_models", "task_plans", "observations", "sensitive", "provider_trace", "browser_profile", "export_package", "operational_metadata"] },
        "purpose": { "enum": ["serve_requests", "consolidation", "personal_training", "reembedding", "triggers", "one_to_one_reply", "subject_request", "browser_tasks", "routing_trace", "export", "operations"] },
        "location": { "enum": ["user_device", "attested_tee", "executor_microvm", "encrypted_store"] },
        "accessor": { "enum": ["user", "one", "executor", "suiss_operator"] },
        "consent": { "enum": ["not_required", "explicit"] }
      }
    }
  }
}
