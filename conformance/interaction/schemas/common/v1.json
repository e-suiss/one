{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/interaction/common/v1.json",
  "title": "Interaction common definitions",
  "description": "Shared Interaction types and the owner of surface classes, money (decimal strings), localized text, core kinds, risk, reversibility and interruption for every One contract. Identifiers, references, data classes and provenance labels are referred to their owners (X-12, X-22, C-25, C-26).",
  "$defs": {
    "interaction_id": {
      "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/InteractionId"
    },
    "device_id": {
      "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/DeviceId"
    },
    "task_id": {
      "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/TaskId"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "duration": {
      "type": "string",
      "pattern": "^P(?:[0-9]+D(?:T(?:[0-9]+H(?:[0-9]+M)?(?:[0-9]+S)?|[0-9]+M(?:[0-9]+S)?|[0-9]+S))?|T(?:[0-9]+H(?:[0-9]+M)?(?:[0-9]+S)?|[0-9]+M(?:[0-9]+S)?|[0-9]+S))$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,86}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "core_kind": {
      "enum": [
        "approval",
        "choice",
        "question",
        "info",
        "progress",
        "receipt",
        "comparison",
        "form",
        "digest_item"
      ]
    },
    "extension_name": {
      "type": "string",
      "pattern": "^app\\.suiss\\.[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$",
      "not": {
        "pattern": "^app\\.suiss\\.one\\."
      },
      "maxLength": 128
    },
    "surface_class": {
      "enum": [
        "phone",
        "desktop",
        "watch",
        "voice:car",
        "voice:glasses"
      ]
    },
    "risk": {
      "enum": [
        "CT0",
        "CT1",
        "CT2",
        "CT3"
      ]
    },
    "reversibility": {
      "enum": [
        "reversible",
        "compensable",
        "irreversible"
      ]
    },
    "interruption": {
      "enum": [
        "passive",
        "active",
        "time-sensitive",
        "critical"
      ]
    },
    "authentication": {
      "enum": [
        "none",
        "device_unlock",
        "passkey"
      ]
    },
    "line": {
      "type": "string",
      "pattern": "^[^\\r\\n\\t]+$"
    },
    "localized": {
      "description": "TR and EN text, both required (X-52).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tr",
        "en"
      ],
      "properties": {
        "tr": {
          "$ref": "#/$defs/line",
          "minLength": 1
        },
        "en": {
          "$ref": "#/$defs/line",
          "minLength": 1
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "currency"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "deep_link": {
      "description": "Deep link to an Interaction version; the identifier part is exactly the ontology InteractionId grammar",
      "type": "string",
      "pattern": "^https://suiss\\.app/one/i/int_[0-7][0-9a-hjkmnp-tv-z]{9}[ef][0-9a-hjkmnp-tv-z]{2}[89abrstv][0-9a-hjkmnp-tv-z]{12}(\\?v=[1-9][0-9]*)?$"
    }
  }
}
