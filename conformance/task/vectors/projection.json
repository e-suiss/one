  {
    "rule": "C-27",
    "description": "A2A rejected is never derived from a task state; it only answers a refused submission",
    "input": {
      "intake": "submission_refused_before_task_exists"
    },
    "expected": {
      "mcp_tasks": "none",
      "a2a_task": "TASK_STATE_REJECTED"
    }
  },
  {
    "rule": "C-27",
    "description": "An inbound protocol state is never written to the task",
    "input": {
      "inbound": {
        "a2a_task": "TASK_STATE_COMPLETED"
      },
      "state": "running"
    },
    "expected": {
      "state": "running"
    }
  }
