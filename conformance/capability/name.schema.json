{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/capability/name/v1.json",
  "title": "Capability name",
  "description": "Semantic, provider-independent capability names under the reverse-DNS root app.suiss, dated versions, extends and the negotiation declaration. Grammar and negotiation rules are in naming.toml.",
  "$ref": "#/$defs/declaration",
  "$defs": {
    "suiss_name": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^app\\.suiss(\\.[a-z][a-z0-9]{0,31}){2,5}$",
      "not": {
        "pattern": "^app\\.suiss\\.(one|access|relay|work|pay|suiss|www|api)(\\.|$)"
      }
    },
    "third_party_name": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z]{2,63}(\\.[a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?){2,9}$",
      "not": {
        "pattern": "^app\\.suiss(\\.|$)"
      }
    },
    "name": {
      "anyOf": [
        {
          "$ref": "#/$defs/suiss_name"
        },
        {
          "$ref": "#/$defs/third_party_name"
        }
      ]
    },
    "version": {
      "description": "Capability version as a date, newest is highest; same form as UCP.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "extends": {
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      ]
    },
    "declaration": {
      "description": "One side's offer of a capability during negotiation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "versions"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "extends": {
          "$ref": "#/$defs/extends"
        }
      },
      "if": {
        "properties": {
          "name": {
            "$ref": "#/$defs/third_party_name"
          }
        }
      },
      "then": {
        "required": [
          "extends"
        ]
      }
    },
    "offer": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declaration"
      }
    },
    "ref": {
      "description": "A capability by name and dated version; the one capability reference form used by tasks, intents, federation and model requests",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    }
  }
}
