  {
    "rule": "A-14",
    "description": "Tokyo flight under 40k TRY until end of November",
    "input": {
      "event_source": {
        "kind": "price_watch",
        "ref": "watch:flight-ist-hnd"
      },
      "condition": {
        "language": "suiss-restriction",
        "language_version": "1",
        "expression": "price.value < 40000 && price.currency == \"TRY\""
      },
      "action": {
        "action_ref": {
          "namespace": "app.suiss.travel.flight.book",
          "name": "book",
          "version": "2026-10-01",
          "schema_digest": "sha256:abababababababababababababababababababababababababababababababab"
        },
        "target": {
          "kind": "merchant",
          "ref": "airline-7"
        }
      },
      "budget": {
        "amount": {
          "value": "40000.00",
          "currency": "TRY"
        },
        "count": 1
      },
      "ends_at": "2026-11-30T00:00:00Z",
      "mandate": {
        "mandate_ref": {
          "ref": "MandateRef",
          "id": "tokyo-flight"
        },
        "behaviour": "act",
        "ends_at": "2026-12-01T00:00:00Z",
        "budget": {
          "amount": {
            "value": "40000.00",
            "currency": "TRY"
          },
          "count": 1
        }
      }
    },
    "valid": true
