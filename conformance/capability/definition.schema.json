{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/capability/definition/v1.json",
  "title": "CapabilityDefinition",
  "description": "A capability registry entry. A definition is not authority. An entry missing any field is rejected; input and output schemas are closed JSON Schema 2020-12 objects without password, token, secret, cookie or card fields. Carries the C-19 record header; `version` is the record version and `capability_version` the dated capability version.",
  "type": "object",
  "required": [
    "type",
    "id",
    "status",
    "supersedes",
    "name",
    "capability_version",
    "publisher",
    "meaning",
    "actions",
    "input_schema",
    "output_schema",
    "examples",
    "authority",
    "autonomy_ceiling",
    "reversibility",
    "data_access",
    "surface",
    "providers",
    "test_status",
    "projections"
  ],
  "properties": {
    "type": {
      "const": "CapabilityDefinition"
    },
    "id": {
      "$ref": "https://suiss.app/schemas/one/task/common/v1.json#/$defs/capability_id"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deleted"
      ]
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://suiss.app/schemas/one/task/common/v1.json#/$defs/capability_id"
        }
      ]
    },
    "name": {
      "$ref": "https://suiss.app/schemas/one/capability/name/v1.json#/$defs/name"
    },
    "capability_version": {
      "$ref": "https://suiss.app/schemas/one/capability/name/v1.json#/$defs/version"
    },
    "extends": {
      "$ref": "https://suiss.app/schemas/one/capability/name/v1.json#/$defs/extends"
    },
    "publisher": {
      "$ref": "https://suiss.app/schemas/one/task/common/v1.json#/$defs/party_ref"
    },
    "meaning": {
      "$ref": "https://suiss.app/schemas/one/task/common/v1.json#/$defs/localized_text"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "action_ref"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "undo",
              "compensate"
            ]
          },
          "action_ref": {
            "$ref": "https://suiss.app/schemas/one/ontology/reference/v1.json#/$defs/ActionRef"
          }
        }
      },
      "contains": {
        "properties": {
          "role": {
            "const": "primary"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "input_schema": {
      "$ref": "#/$defs/typed_schema"
    },
    "output_schema": {
      "$ref": "#/$defs/typed_schema"
    },
    "examples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lang",
          "utterance",
          "input"
        ],
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "tr",
              "en"
            ]
          },
          "utterance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "input": {
            "type": "object"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "lang": {
                "const": "tr"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "lang": {
                "const": "en"
              }
            }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_scope",
        "consequence_tier"
      ],
      "properties": {
        "grant_scope": {
          "$ref": "https://suiss.app/schemas/one/task/common/v1.json#/$defs/opaque_ref"
        },
        "consequence_tier": {
          "$ref": "https://suiss.app/schemas/one/interaction/common/v1.json#/$defs/risk"
        }
      }
    },
    "autonomy_ceiling": {
      "$ref": "https://suiss.app/schemas/one/task/common/v1.json#/$defs/autonomy_behaviour"
    },
    "reversibility": {
      "$ref": "https://suiss.app/schemas/one/interaction/common/v1.json#/$defs/reversibility"
    },
    "data_access": {
      "description": "Data the capability reads and writes, each a data class or null when none",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reads",
        "writes"
      ],
      "properties": {
        "reads": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://suiss.app/schemas/one/memory/data-class/v1.json"
            }
          ]
        },
        "writes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://suiss.app/schemas/one/memory/data-class/v1.json"
            }
          ]
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modalities",
        "approval_ceiling"
      ],
      "properties": {
        "modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "voice",
              "haptic",
              "small_visual",
              "full_visual"
            ]
          }
        },
        "approval_ceiling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface_classes",
            "min_assurance"
          ],
          "properties": {
            "surface_classes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "https://suiss.app/schemas/one/interaction/common/v1.json#/$defs/surface_class"
              }
            },
            "min_assurance": {
              "$ref": "https://suiss.app/schemas/one/task/common/v1.json#/$defs/authentication"
            }
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_ref",
          "path_type"
        ],
        "properties": {
          "provider_ref": {
            "$ref": "https://suiss.app/schemas/one/task/common/v1.json#/$defs/opaque_ref"
          },
          "path_type": {
            "type": "string",
            "enum": [
              "api",
              "mcp",
              "commerce_protocol",
              "os_intent",
              "browser"
            ]
          }
        }
      }
    },
    "test_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_success_at",
        "last_result",
        "evaluation_ref",
        "verified"
      ],
      "properties": {
        "last_success_at": {
          "$ref": "https://suiss.app/schemas/one/task/common/v1.json#/$defs/timestamp"
        },
        "last_result": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evaluation_ref": {
          "$ref": "https://suiss.app/schemas/one/task/common/v1.json#/$defs/opaque_ref"
        },
        "verified": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reversibility",
            "data_access",
            "surface"
          ],
          "properties": {
            "reversibility": {
              "type": "boolean"
            },
            "data_access": {
              "type": "boolean"
            },
            "surface": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "projections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp_tool": {
          "$ref": "https://suiss.app/schemas/one/capability/name/v1.json#/$defs/name"
        },
        "a2a_skill": {
          "$ref": "https://suiss.app/schemas/one/capability/name/v1.json#/$defs/name"
        },
        "apple_app_schema": {
          "type": "string",
          "pattern": "^\\.[a-z]+\\.[A-Za-z]+$"
        },
        "android_app_function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ucp": {
          "$ref": "https://suiss.app/schemas/one/capability/name/v1.json#/$defs/third_party_name"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://suiss.app/schemas/one/memory/common/v1.json#/$defs/record_header"
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "properties": {
          "supersedes": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "supersedes": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "$ref": "https://suiss.app/schemas/one/capability/name/v1.json#/$defs/third_party_name"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "required": [
          "extends"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reversibility": {
            "const": "reversible"
          }
        },
        "required": [
          "reversibility"
        ]
      },
      "then": {
        "properties": {
          "actions": {
            "contains": {
              "properties": {
                "role": {
                  "const": "undo"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reversibility": {
            "const": "compensable"
          }
        },
        "required": [
          "reversibility"
        ]
      },
      "then": {
        "properties": {
          "actions": {
            "contains": {
              "properties": {
                "role": {
                  "const": "compensate"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reversibility": {
            "const": "irreversible"
          }
        },
        "required": [
          "reversibility"
        ]
      },
      "then": {
        "properties": {
          "actions": {
            "not": {
              "contains": {
                "properties": {
                  "role": {
                    "enum": [
                      "undo",
                      "compensate"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "reversibility": {
                "const": "irreversible"
              }
            },
            "required": [
              "reversibility"
            ]
          },
          {
            "properties": {
              "authority": {
                "properties": {
                  "consequence_tier": {
                    "enum": [
                      "CT2",
                      "CT3"
                    ]
                  }
                },
                "required": [
                  "consequence_tier"
                ]
              }
            },
            "required": [
              "authority"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "surface": {
            "properties": {
              "approval_ceiling": {
                "properties": {
                  "surface_classes": {
                    "items": {
                      "enum": [
                        "phone",
                        "desktop"
                      ]
                    }
                  },
                  "min_assurance": {
                    "const": "passkey"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "forbidden_name": {
      "type": "string",
      "pattern": "(^|_)(password|passwd|passcode|passphrase|pin|otp|totp|token|secret|secrets|credential|credentials|cookie|cookies|session_key|api_key|apikey|private_key|card|pan|cvv|cvc|cvv2)(_|$)"
    },
    "safe_property_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "not": {
        "$ref": "#/$defs/forbidden_name"
      }
    },
    "safe_schema_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/safe_schema"
      }
    },
    "safe_schema": {
      "type": [
        "object",
        "boolean"
      ],
      "properties": {
        "properties": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/safe_property_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/safe_schema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_property_name"
          }
        },
        "dependentRequired": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/safe_property_name"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/safe_property_name"
            }
          }
        },
        "dependentSchemas": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/safe_property_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/safe_schema"
          }
        },
        "additionalProperties": {
          "const": false
        },
        "patternProperties": false,
        "unevaluatedProperties": false,
        "propertyNames": false,
        "items": {
          "$ref": "#/$defs/safe_schema"
        },
        "prefixItems": {
          "$ref": "#/$defs/safe_schema_array"
        },
        "contains": {
          "$ref": "#/$defs/safe_schema"
        },
        "unevaluatedItems": {
          "$ref": "#/$defs/safe_schema"
        },
        "allOf": {
          "$ref": "#/$defs/safe_schema_array"
        },
        "anyOf": {
          "$ref": "#/$defs/safe_schema_array"
        },
        "oneOf": {
          "$ref": "#/$defs/safe_schema_array"
        },
        "not": {
          "$ref": "#/$defs/safe_schema"
        },
        "if": {
          "$ref": "#/$defs/safe_schema"
        },
        "then": {
          "$ref": "#/$defs/safe_schema"
        },
        "else": {
          "$ref": "#/$defs/safe_schema"
        },
        "$defs": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/safe_schema"
          }
        },
        "$ref": {
          "type": "string",
          "pattern": "^(#/\\$defs/[a-z][a-z0-9_]{0,63}|https://suiss\\.app/schemas/one/[a-z0-9-]+/[a-z0-9-]+/v[0-9]+\\.json(#/\\$defs/[a-z][a-z0-9_]{0,63})?)$"
        },
        "$dynamicRef": false,
        "format": {
          "not": {
            "enum": [
              "password"
            ]
          }
        },
        "writeOnly": {
          "const": false
        }
      },
      "if": {
        "type": "object",
        "anyOf": [
          {
            "required": [
              "properties"
            ]
          },
          {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "object"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "additionalProperties"
        ]
      }
    },
    "inline_typed_schema": {
      "allOf": [
        {
          "$ref": "#/$defs/safe_schema"
        },
        {
          "type": "object",
          "required": [
            "$schema",
            "type",
            "properties",
            "additionalProperties"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "type": {
              "const": "object"
            }
          }
        }
      ]
    },
    "schema_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^https://suiss\\.app/schemas/one/[a-z0-9-]+/[a-z0-9-]+/v[0-9]+\\.json$"
        }
      }
    },
    "typed_schema": {
      "oneOf": [
        {
          "$ref": "#/$defs/inline_typed_schema"
        },
        {
          "$ref": "#/$defs/schema_reference"
        }
      ]
    }
  },
  "unevaluatedProperties": false
}
