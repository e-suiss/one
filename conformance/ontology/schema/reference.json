{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/ontology/reference/v1.json",
  "title": "One references to objects owned elsewhere",
  "description": "Reference types. Every reference to an object owned elsewhere is {ref, id}: `ref` names the kind and `id` is the owner's opaque identifier; One keeps no second canonical copy. The only exception is ActionRef, which is Access's structured form. RecordRef points at a canonical One record by its typed identifier.",
  "$defs": {
    "opaque_id": {
      "description": "The owner's identifier, treated as opaque; One never parses it",
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,255}$"
    },
    "RecordRef": {
      "description": "A canonical One record; the identifier prefix names its concept",
      "type": "object",
      "properties": {
        "ref": {
          "const": "RecordRef"
        },
        "id": {
          "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/CanonicalId"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "PartyRef": {
      "description": "A person or the One agent Party (Access Party); owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "PartyRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "InstanceRef": {
      "description": "An agent, sub-agent or device-bound Instance (Access AgentInstance); owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "InstanceRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "KeyBindingRef": {
      "description": "A device KeyBinding; owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "KeyBindingRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "ExecutorRef": {
      "description": "A local or cloud executor registration (Access E57); owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "ExecutorRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "GrantRef": {
      "description": "A Grant; owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "GrantRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "MandateRef": {
      "description": "A Mandate (behaviour envelope); owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "MandateRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "TriggerRef": {
      "description": "A Trigger bound to a Mandate (Access E46); owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "TriggerRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "ExerciseRef": {
      "description": "An Exercise; owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "ExerciseRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "DecisionRecordRef": {
      "description": "An Access DecisionRecord: an authority decision, an approval act or a continuation decision (Access E31, E45, E49 (3)); owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "DecisionRecordRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "ClaimRef": {
      "description": "An Executor Claim; owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "ClaimRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "AcceptanceRef": {
      "description": "A relationship level (Access Acceptance, E55); owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "AcceptanceRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "ConnectedAccountRef": {
      "description": "A connected account held in the Access token vault; owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "ConnectedAccountRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "ActionRef": {
      "description": "Structured Access ActionRef: capability namespace, action name and dated version, with the action schema digest as a separate mandatory member (Access 9.13.3, 9.13.5); owned by Access. Reference only, never a copy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name",
        "version",
        "schema_digest"
      ],
      "properties": {
        "namespace": {
          "$ref": "https://suiss.app/schemas/one/capability/name/v1.json#/$defs/name"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "version": {
          "$ref": "https://suiss.app/schemas/one/capability/name/v1.json#/$defs/version"
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "HouseholdRef": {
      "description": "A household (Access E53); owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "HouseholdRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "GuardianshipRef": {
      "description": "A guardianship (Access E53); owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "GuardianshipRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "AgeBandRef": {
      "description": "An age band (Access E53); never a birth date; owned by Access. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "AgeBandRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "CommitmentRef": {
      "description": "A Work Commitment; owned by Work. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "CommitmentRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "OfferChainRef": {
      "description": "A Work offer chain; owned by Work. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "OfferChainRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "NeedsAttentionRef": {
      "description": "A Work Needs Attention item; owned by Work. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "NeedsAttentionRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "TenantRef": {
      "description": "A Work personal tenant; owned by Work. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "TenantRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "NotificationRef": {
      "description": "A Relay notification; owned by Relay. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "NotificationRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "WaitpointRef": {
      "description": "A Relay waitpoint; owned by Relay. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "WaitpointRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "MailboxMessageRef": {
      "description": "A Relay mailbox message; owned by Relay. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "MailboxMessageRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "ExecutionReportRef": {
      "description": "An Executor effect or execution report; owned by Executor. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "ExecutionReportRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "CheckpointRef": {
      "description": "An Executor checkpoint; owned by Executor. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "CheckpointRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "PaymentRef": {
      "description": "A Pay payment; owned by Pay. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "PaymentRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "OrderRef": {
      "description": "A Pay order; owned by Pay. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "OrderRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "AgentTokenRef": {
      "description": "A Pay agent token; owned by Pay. Reference only, never a copy",
      "type": "object",
      "properties": {
        "ref": {
          "const": "AgentTokenRef"
        },
        "id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "ref",
        "id"
      ],
      "additionalProperties": false
    },
    "AccessObjectRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/PartyRef"
        },
        {
          "$ref": "#/$defs/InstanceRef"
        },
        {
          "$ref": "#/$defs/KeyBindingRef"
        },
        {
          "$ref": "#/$defs/ExecutorRef"
        },
        {
          "$ref": "#/$defs/GrantRef"
        },
        {
          "$ref": "#/$defs/MandateRef"
        },
        {
          "$ref": "#/$defs/TriggerRef"
        },
        {
          "$ref": "#/$defs/ExerciseRef"
        },
        {
          "$ref": "#/$defs/DecisionRecordRef"
        },
        {
          "$ref": "#/$defs/ClaimRef"
        },
        {
          "$ref": "#/$defs/AcceptanceRef"
        },
        {
          "$ref": "#/$defs/ConnectedAccountRef"
        },
        {
          "$ref": "#/$defs/ActionRef"
        },
        {
          "$ref": "#/$defs/HouseholdRef"
        },
        {
          "$ref": "#/$defs/GuardianshipRef"
        },
        {
          "$ref": "#/$defs/AgeBandRef"
        }
      ]
    },
    "WorkObjectRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/CommitmentRef"
        },
        {
          "$ref": "#/$defs/OfferChainRef"
        },
        {
          "$ref": "#/$defs/NeedsAttentionRef"
        },
        {
          "$ref": "#/$defs/TenantRef"
        }
      ]
    },
    "RelayObjectRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/NotificationRef"
        },
        {
          "$ref": "#/$defs/WaitpointRef"
        },
        {
          "$ref": "#/$defs/MailboxMessageRef"
        }
      ]
    },
    "ExecutorObjectRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/ExecutionReportRef"
        },
        {
          "$ref": "#/$defs/CheckpointRef"
        }
      ]
    },
    "PayObjectRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/PaymentRef"
        },
        {
          "$ref": "#/$defs/OrderRef"
        },
        {
          "$ref": "#/$defs/AgentTokenRef"
        }
      ]
    },
    "external_system": {
      "description": "Kind of source system that holds the content",
      "enum": [
        "contacts",
        "email",
        "calendar",
        "messaging",
        "document",
        "files",
        "photos",
        "web",
        "place",
        "agent",
        "service"
      ]
    },
    "locator": {
      "description": "Source-side locator (URI or provider key); content stays at the source",
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "ExternalRef": {
      "description": "An object held by a source system (calendar event, e-mail, document, booking, place, web page)",
      "type": "object",
      "properties": {
        "ref": {
          "const": "ExternalRef"
        },
        "system": {
          "$ref": "#/$defs/external_system"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "account": {
          "$ref": "#/$defs/ConnectedAccountRef"
        }
      },
      "required": [
        "ref",
        "system",
        "locator"
      ],
      "additionalProperties": false
    },
    "ExternalPersonRef": {
      "description": "A person who is not in Suiss. Only a pointer to the source entry; name, role and last contact live in a relationship memory record; no birth date",
      "type": "object",
      "properties": {
        "ref": {
          "const": "ExternalPersonRef"
        },
        "system": {
          "enum": [
            "contacts",
            "email",
            "messaging"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "account": {
          "$ref": "#/$defs/ConnectedAccountRef"
        }
      },
      "required": [
        "ref",
        "system",
        "locator"
      ],
      "additionalProperties": false
    },
    "ProductRef": {
      "description": "A reference to an object owned by another Suiss product",
      "oneOf": [
        {
          "$ref": "#/$defs/AccessObjectRef"
        },
        {
          "$ref": "#/$defs/WorkObjectRef"
        },
        {
          "$ref": "#/$defs/RelayObjectRef"
        },
        {
          "$ref": "#/$defs/ExecutorObjectRef"
        },
        {
          "$ref": "#/$defs/PayObjectRef"
        }
      ]
    },
    "PersonRef": {
      "description": "A person: a Suiss Party or an external person",
      "oneOf": [
        {
          "$ref": "#/$defs/PartyRef"
        },
        {
          "$ref": "#/$defs/ExternalPersonRef"
        }
      ]
    },
    "AnyRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProductRef"
        },
        {
          "$ref": "#/$defs/ExternalRef"
        },
        {
          "$ref": "#/$defs/ExternalPersonRef"
        }
      ]
    },
    "EntityRef": {
      "description": "What a memory record or relationship edge is about (C-12, C-23 about): the owner or another Suiss person (PartyRef), a person outside Suiss, a place or other source-held object (ExternalRef), or a Goal or Routine (RecordRef)",
      "oneOf": [
        {
          "$ref": "#/$defs/PartyRef"
        },
        {
          "$ref": "#/$defs/ExternalPersonRef"
        },
        {
          "$ref": "#/$defs/ExternalRef"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/RecordRef"
            },
            {
              "properties": {
                "id": {
                  "anyOf": [
                    {
                      "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/GoalId"
                    },
                    {
                      "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/RoutineId"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "Target": {
      "description": "Target of a concerns or references link: a canonical One record, another Suiss product's object or a source-held object",
      "oneOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "$ref": "#/$defs/AnyRef"
        }
      ]
    }
  },
  "$ref": "#/$defs/AnyRef"
}
