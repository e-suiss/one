{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/ontology/routine/v1.json",
  "title": "Routine",
  "description": "An explainable behaviour hypothesis. Never authority and never a Trigger: an action from a Routine arises only as suggestion, user approval, Access Grant.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://suiss.app/schemas/one/memory/common/v1.json#/$defs/record_header"
    },
    {
      "if": {
        "properties": {
          "trigger": {
            "required": [
              "place"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "sensitive": {
            "const": true
          }
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "Routine"
    },
    "id": {
      "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/RoutineId"
    },
    "trigger": {
      "description": "Readable condition; not an Access Trigger",
      "type": "object",
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "time_window": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "end": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "place": {
          "$ref": "https://suiss.app/schemas/one/ontology/reference/v1.json#/$defs/ExternalRef"
        },
        "context": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "lang": {
              "enum": [
                "tr",
                "en"
              ]
            }
          },
          "required": [
            "text",
            "lang"
          ],
          "additionalProperties": false
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "behaviour": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "https://suiss.app/schemas/one/capability/name/v1.json#/$defs/name"
        },
        "preference": {
          "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/MemoryRecordId"
        },
        "summary": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "lang": {
              "enum": [
                "tr",
                "en"
              ]
            }
          },
          "required": [
            "text",
            "lang"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "capability",
        "summary"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "description": "Spontaneous and after-suggestion observations are counted apart",
      "type": "object",
      "properties": {
        "spontaneous": {
          "type": "integer",
          "minimum": 0
        },
        "after_suggestion": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "spontaneous",
        "after_suggestion"
      ],
      "additionalProperties": false
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "lang": {
            "enum": [
              "tr",
              "en"
            ]
          }
        },
        "required": [
          "text",
          "lang"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "first_seen": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "period": {
      "description": "Expected recurrence, ISO 8601 duration",
      "type": "string",
      "pattern": "^P(?:(?:[0-9]+Y(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?|[0-9]+M(?:[0-9]+W)?(?:[0-9]+D)?|[0-9]+W(?:[0-9]+D)?|[0-9]+D)(?:T(?:[0-9]+H(?:[0-9]+M)?(?:[0-9]+S)?|[0-9]+M(?:[0-9]+S)?|[0-9]+S))?|T(?:[0-9]+H(?:[0-9]+M)?(?:[0-9]+S)?|[0-9]+M(?:[0-9]+S)?|[0-9]+S))$"
    },
    "source": {
      "enum": [
        "learned",
        "stated",
        "confirmed"
      ]
    },
    "state": {
      "enum": [
        "active",
        "suspended",
        "invalid"
      ]
    },
    "authority": {
      "description": "Fixed; cannot be changed",
      "const": "NONE"
    },
    "sensitive": {
      "type": "boolean",
      "default": true
    },
    "derived_from": {
      "description": "Evidence: routine memory records",
      "type": "array",
      "items": {
        "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/MemoryRecordId"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "extensions": {
      "description": "Typed extension fields (C-7): reverse-DNS name under app.suiss mapped to this concept in the extension registry",
      "type": "object",
      "propertyNames": {
        "$ref": "https://suiss.app/schemas/one/ontology/extension/v1.json#/$defs/suiss_name"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "value": true
        },
        "required": [
          "version",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "const": "active"
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/RoutineId"
        }
      ]
    }
  },
  "required": [
    "type",
    "id",
    "status",
    "trigger",
    "behaviour",
    "evidence",
    "exceptions",
    "first_seen",
    "last_seen",
    "period",
    "source",
    "state",
    "authority",
    "sensitive",
    "derived_from"
  ],
  "unevaluatedProperties": false
}
