[
  {
    "rule": "C-8",
    "description": "Explicit remember: the user asked, so an utterance becomes a stated memory record",
    "input": {
      "from": "observation",
      "to": "memory",
      "user_asked": true
    },
    "expected": {
      "function": "remember_explicit"
    }
  },
  {
    "rule": "C-8",
    "description": "Without an explicit request an observation becomes an observed memory record",
    "input": {
      "from": "observation",
      "to": "memory",
      "user_asked": false
    },
    "expected": {
      "function": "record_observed"
    }
  },
  {
    "rule": "C-8",
    "description": "Background inference yields an inferred or hypothesis record",
    "input": {
      "from": "observation",
      "to": "inference",
      "user_asked": false
    },
    "expected": {
      "function": "infer"
    }
  },
  {
    "rule": "M-1",
    "description": "Inference becomes durable memory only by confirmation",
    "input": {
      "from": "inference",
      "to": "memory",
      "user_asked": false
    },
    "expected": {
      "function": "confirm"
    }
  },
  {
    "rule": "C-20",
    "description": "Correction is a new version that supersedes",
    "input": {
      "from": "memory",
      "to": "memory",
      "user_asked": false
    },
    "expected": {
      "function": "correct"
    }
  },
  {
    "rule": "C-14",
    "description": "Routine to action passes through a suggestion Interaction",
    "input": {
      "from": "memory",
      "to": "interaction",
      "user_asked": false
    },
    "expected": {
      "function": "suggest"
    }
  },
  {
    "rule": "C-8",
    "description": "No path from memory to authority",
    "input": {
      "from": "memory",
      "to": "authority",
      "user_asked": false
    },
    "expected": "rejected"
  },
  {
    "rule": "C-8",
    "description": "No path from inference to authority",
    "input": {
      "from": "inference",
      "to": "authority",
      "user_asked": false
    },
    "expected": "rejected"
  },
  {
    "rule": "C-8",
    "description": "No path from observation to authority",
    "input": {
      "from": "observation",
      "to": "authority",
      "user_asked": false
    },
    "expected": "rejected"
  },
  {
    "rule": "C-8",
    "description": "An approval Interaction is not authority; Access decides",
    "input": {
      "from": "interaction",
      "to": "authority",
      "user_asked": false
    },
    "expected": "rejected"
  },
  {
    "rule": "M-1",
    "description": "Observation never jumps to authority through memory in one step",
    "input": {
      "from": "observation",
      "to": "memory+authority",
      "user_asked": false
    },
    "expected": "rejected"
  },
  {
    "rule": "M-1",
    "description": "Unlisted conversions are rejected",
    "input": {
      "from": "inference",
      "to": "observation",
      "user_asked": false
    },
    "expected": "rejected"
  }
]
