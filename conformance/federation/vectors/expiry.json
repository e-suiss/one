      "workOperation": null
    }
  },
  {
    "rule": "OO-16",
    "description": "Sender-claimed sentAt before expiry does not rescue a late enqueue",
    "input": {
      "offerExpiresAt": "2026-11-05T10:00:00Z",
      "reply": {
        "kind": "commitment",
        "sentAt": "2026-11-05T09:00:00Z"
      },
      "relayEnqueuedAt": "2026-11-05T10:00:01Z"
    },
    "expected": {
      "accept": false,
      "refusal": "offer-expired",
      "workOperation": null
    }
  },
  {
    "rule": "OO-16",
