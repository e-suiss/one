    "input": {
      "offerExpiresAt": "2026-11-05T10:00:00Z",
      "reply": {
        "kind": "commitment",
        "sentAt": "2026-11-05T09:59:00Z"
      },
      "receivedAt": "2026-11-05T10:00:05Z"
    },
    "expected": {
      "accept": false,
