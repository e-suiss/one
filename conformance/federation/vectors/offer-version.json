[
  {
    "rule": "OO-16",
    "description": "Counter-offer increases the version by one",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        }
      ],
      "next": {
        "kind": "counter-offer",
        "offerVersion": 2,
        "inReplyToVersion": 1
      }
    },
    "expected": {
      "accept": true
    }
  },
  {
    "rule": "OO-16",
    "description": "Third version after two counters",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        },
        {
          "kind": "counter-offer",
          "offerVersion": 2
        }
      ],
      "next": {
        "kind": "counter-offer",
        "offerVersion": 3,
        "inReplyToVersion": 2
      }
    },
    "expected": {
      "accept": true
    }
  },
  {
    "rule": "OO-16",
    "description": "Counter-offer repeating the current version",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        },
        {
          "kind": "counter-offer",
          "offerVersion": 2
        }
      ],
      "next": {
        "kind": "counter-offer",
        "offerVersion": 2,
        "inReplyToVersion": 2
      }
    },
    "expected": {
      "accept": false,
      "refusal": "version-not-monotonic"
    }
  },
  {
    "rule": "OO-16",
    "description": "Counter-offer decreasing the version",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        },
        {
          "kind": "counter-offer",
          "offerVersion": 2
        }
      ],
      "next": {
        "kind": "counter-offer",
        "offerVersion": 1,
        "inReplyToVersion": 2
      }
    },
    "expected": {
      "accept": false,
      "refusal": "version-not-monotonic"
    }
  },
  {
    "rule": "OO-16",
    "description": "Counter-offer skipping a version",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        }
      ],
      "next": {
        "kind": "counter-offer",
        "offerVersion": 3,
        "inReplyToVersion": 1
      }
    },
    "expected": {
      "accept": false,
      "refusal": "version-not-monotonic"
    }
  },
  {
    "rule": "OO-16",
    "description": "Counter-offer replying to a superseded version",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        },
        {
          "kind": "counter-offer",
          "offerVersion": 2
        }
      ],
      "next": {
        "kind": "counter-offer",
        "offerVersion": 3,
        "inReplyToVersion": 1
      }
    },
    "expected": {
      "accept": false,
      "refusal": "reply-version-mismatch"
    }
  },
  {
    "rule": "OO-16",
    "description": "Commitment to the latest version",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        },
        {
          "kind": "counter-offer",
          "offerVersion": 2
        }
      ],
      "next": {
        "kind": "commitment",
        "offerVersion": 2,
        "inReplyToVersion": 2
      }
    },
    "expected": {
      "accept": true
    }
  },
  {
    "rule": "OO-16",
    "description": "Commitment to a superseded version",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        },
        {
          "kind": "counter-offer",
          "offerVersion": 2
        }
      ],
      "next": {
        "kind": "commitment",
        "offerVersion": 1,
        "inReplyToVersion": 1
      }
    },
    "expected": {
      "accept": false,
      "refusal": "reply-version-mismatch"
    }
  },
  {
    "rule": "OO-16",
    "description": "Commitment whose envelope version differs from the version it answers",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        },
        {
          "kind": "counter-offer",
          "offerVersion": 2
        }
      ],
      "next": {
        "kind": "commitment",
        "offerVersion": 3,
        "inReplyToVersion": 2
      }
    },
    "expected": {
      "accept": false,
      "refusal": "reply-version-mismatch"
    }
  },
  {
    "rule": "OO-16",
    "description": "Rejection of the latest version",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        }
      ],
      "next": {
        "kind": "rejection",
        "offerVersion": 1,
        "inReplyToVersion": 1
      }
    },
    "expected": {
      "accept": true
    }
  },
  {
    "rule": "OO-16",
    "description": "Query carries the current chain version",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        },
        {
          "kind": "counter-offer",
          "offerVersion": 2
        }
      ],
      "next": {
        "kind": "query",
        "offerVersion": 2
      }
    },
    "expected": {
      "accept": true
    }
  },
  {
    "rule": "OO-16",
    "description": "Query does not advance the version",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1
        }
      ],
      "next": {
        "kind": "query",
        "offerVersion": 2
      }
    },
    "expected": {
      "accept": false,
      "refusal": "version-not-monotonic"
    }
  },
  {
    "rule": "OO-16",
    "description": "Answer carries the version of its query",
    "input": {
      "chain": [
        {
          "kind": "query",
          "offerVersion": 0
        }
      ],
      "next": {
        "kind": "answer",
        "offerVersion": 0,
        "inReplyToVersion": 0
      }
    },
    "expected": {
      "accept": true
    }
  },
  {
    "rule": "OO-16",
    "description": "A replayed earlier version is detected by digest even with the right number",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1,
          "digest": "sha-256:2M7jnCaWtQePydYi1JDwfuzRshTRS11BCyTYLhsjQCE"
        }
      ],
      "next": {
        "kind": "commitment",
        "offerVersion": 1,
        "inReplyToVersion": 1,
        "inReplyToDigest": "sha-256:PST_iBBdje4BLKay32706ATe7qXthzcjb43rhEnWDh4"
      }
    },
    "expected": {
      "accept": false,
      "refusal": "digest-mismatch"
    }
  },
  {
    "rule": "OO-15",
    "description": "Counter-offer changing the capability",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1,
          "capability": {
            "name": "app.suiss.calendar.event.propose",
            "version": "2026-10-12"
          }
        }
      ],
      "next": {
        "kind": "counter-offer",
        "offerVersion": 2,
        "inReplyToVersion": 1,
        "capability": {
          "name": "app.suiss.calendar.availability.query",
          "version": "2026-10-12"
        }
      }
    },
    "expected": {
      "accept": false,
      "refusal": "kind-mismatch"
    }
  },
  {
    "rule": "OO-16",
    "description": "Message with a different correlation id than the chain",
    "input": {
      "chain": [
        {
          "kind": "offer",
          "offerVersion": 1,
          "correlationId": "019a5a3c-8e00-7a00-8a00-000000000001"
        }
      ],
      "next": {
        "kind": "commitment",
        "offerVersion": 1,
        "inReplyToVersion": 1,
        "correlationId": "019a5a3c-8e00-7a00-8a00-000000000999"
      }
    },
    "expected": {
      "accept": false,
      "refusal": "correlation-mismatch"
    }
  },
  {
    "rule": "OO-16",
    "description": "contextId differs from envelope correlationId",
    "input": {
      "chain": [],
      "next": {
        "kind": "offer",
        "offerVersion": 1,
        "contextId": "019a5a3c-8e00-7a00-8a00-000000000998",
        "correlationId": "019a5a3c-8e00-7a00-8a00-000000000001"
      }
    },
    "expected": {
      "accept": false,
      "refusal": "correlation-mismatch"
    }
  },
  {
    "rule": "OO-15",
    "description": "Body kind differs from envelope kind",
    "input": {
      "chain": [],
      "next": {
        "kind": "offer",
        "bodyKind": "commitment",
        "offerVersion": 1
      }
    },
    "expected": {
      "accept": false,
      "refusal": "kind-mismatch"
    }
  }
]
