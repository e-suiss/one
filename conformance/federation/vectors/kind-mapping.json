[
  {
    "rule": "OO-15",
    "description": "Offer opens the chain as a Work request",
    "input": {
      "kind": "offer",
      "senderRole": "creditor",
      "workState": "none"
    },
    "expected": {
      "accept": true,
      "workOperation": "request",
      "workResult": "requested"
    }
  },
  {
    "rule": "OO-15",
    "description": "Debtor candidate's counter-offer",
    "input": {
      "kind": "counter-offer",
      "senderRole": "debtor-candidate",
      "workState": "requested"
    },
    "expected": {
      "accept": true,
      "workOperation": "counter",
      "workResult": "countered"
    }
  },
  {
    "rule": "OO-15",
    "description": "Creditor's counter-offer to a counter returns the chain to requested",
    "input": {
      "kind": "counter-offer",
      "senderRole": "creditor",
      "workState": "countered"
    },
    "expected": {
      "accept": true,
      "workOperation": "counter",
      "workResult": "requested"
    }
  },
  {
    "rule": "OO-15",
    "description": "Commitment to an offer is a promise",
    "input": {
      "kind": "commitment",
      "senderRole": "debtor-candidate",
      "workState": "requested"
    },
    "expected": {
      "accept": true,
      "workOperation": "promise",
      "workResult": "promised"
    }
  },
  {
    "rule": "OO-15",
    "description": "Commitment to the debtor candidate's counter is accept-counter",
    "input": {
      "kind": "commitment",
      "senderRole": "creditor",
      "workState": "countered"
    },
    "expected": {
      "accept": true,
      "workOperation": "accept-counter",
      "workResult": "promised"
    }
  },
  {
    "rule": "OO-15",
    "description": "Rejection of an offer is a decline with reason code",
    "input": {
      "kind": "rejection",
      "senderRole": "debtor-candidate",
      "workState": "requested"
    },
    "expected": {
      "accept": true,
      "workOperation": "decline",
      "workResult": "declined"
    }
  },
  {
    "rule": "OO-15",
    "description": "Query opens an information wait",
    "input": {
      "kind": "query",
      "senderRole": "creditor",
      "workState": "requested"
    },
    "expected": {
      "accept": true,
      "workOperation": "open-information-wait",
      "workResult": "requested"
    }
  },
  {
    "rule": "OO-15",
    "description": "Query before any offer",
    "input": {
      "kind": "query",
      "senderRole": "creditor",
      "workState": "none"
    },
    "expected": {
      "accept": true,
      "workOperation": "open-information-wait",
      "workResult": "none"
    }
  },
  {
    "rule": "OO-15",
    "description": "Answer satisfies the open information wait with a claim",
    "input": {
      "kind": "answer",
      "senderRole": "debtor-candidate",
      "workState": "information-wait-open"
    },
    "expected": {
      "accept": true,
      "workOperation": "claim",
      "workResult": "information-wait-satisfied"
    }
  },
  {
    "rule": "OO-15",
    "description": "A second offer on an existing chain is refused",
    "input": {
      "kind": "offer",
      "senderRole": "creditor",
      "workState": "requested"
    },
    "expected": {
      "accept": false,
      "refusal": "operation-not-permitted",
      "workOperation": null
    }
  },
  {
    "rule": "OO-15",
    "description": "Creditor cannot counter its own open request",
    "input": {
      "kind": "counter-offer",
      "senderRole": "creditor",
      "workState": "requested"
    },
    "expected": {
      "accept": false,
      "refusal": "operation-not-permitted",
      "workOperation": null
    }
  },
  {
    "rule": "OO-15",
    "description": "Debtor candidate cannot counter its own counter",
    "input": {
      "kind": "counter-offer",
      "senderRole": "debtor-candidate",
      "workState": "countered"
    },
    "expected": {
      "accept": false,
      "refusal": "operation-not-permitted",
      "workOperation": null
    }
  },
  {
    "rule": "OO-15",
    "description": "Debtor candidate cannot accept its own counter",
    "input": {
      "kind": "commitment",
      "senderRole": "debtor-candidate",
      "workState": "countered"
    },
    "expected": {
      "accept": false,
      "refusal": "operation-not-permitted",
      "workOperation": null
    }
  },
  {
    "rule": "OO-15",
    "description": "Creditor cannot promise its own request",
    "input": {
      "kind": "commitment",
      "senderRole": "creditor",
      "workState": "requested"
    },
    "expected": {
      "accept": false,
      "refusal": "operation-not-permitted",
      "workOperation": null
    }
  },
  {
    "rule": "OO-15",
    "description": "Creditor's rejection of a counter has no Work operation in this version and is refused",
    "input": {
      "kind": "rejection",
      "senderRole": "creditor",
      "workState": "countered"
    },
    "expected": {
      "accept": false,
      "refusal": "operation-not-permitted",
      "workOperation": null
    }
  },
  {
    "rule": "OO-15",
    "description": "Commitment after the chain was declined",
    "input": {
      "kind": "commitment",
      "senderRole": "debtor-candidate",
      "workState": "declined"
    },
    "expected": {
      "accept": false,
      "refusal": "operation-not-permitted",
      "workOperation": null
    }
  },
  {
    "rule": "OO-16",
    "description": "Commitment after the chain expired",
    "input": {
      "kind": "commitment",
      "senderRole": "debtor-candidate",
      "workState": "expired"
    },
    "expected": {
      "accept": false,
      "refusal": "offer-expired",
      "workOperation": null
    }
  },
  {
    "rule": "OO-15",
    "description": "Counter-offer after promise is not an amendment",
    "input": {
      "kind": "counter-offer",
      "senderRole": "debtor-candidate",
      "workState": "promised"
    },
    "expected": {
      "accept": false,
      "refusal": "operation-not-permitted",
      "workOperation": null
    }
  },
  {
    "rule": "OO-15",
    "description": "Answer without an open information wait",
    "input": {
      "kind": "answer",
      "senderRole": "debtor-candidate",
      "workState": "requested"
    },
    "expected": {
      "accept": false,
      "refusal": "operation-not-permitted",
      "workOperation": null
    }
  },
  {
    "rule": "OO-15",
    "description": "Query on a closed chain",
    "input": {
      "kind": "query",
      "senderRole": "creditor",
      "workState": "declined"
    },
    "expected": {
      "accept": false,
      "refusal": "operation-not-permitted",
      "workOperation": null
    }
  },
  {
    "rule": "OO-15",
    "description": "Every (kind, sender role, Work state) selects at most one Work operation",
    "input": {
      "table": "a2a-mapping.toml#kind"
    },
    "expected": {
      "maxOperationsPerSelector": 1,
