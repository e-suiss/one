{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/federation/body/v1.json",
  "title": "One Federation typed body",
  "description": "The `data` of the single body DataPart of a typed message. `kind` must equal the envelope `kind`. Typed fields are values of a taxonomy capability's schema; the body carries no free text.",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/kind" }
  },
  "oneOf": [
    { "$ref": "#/$defs/offer" },
    { "$ref": "#/$defs/counterOffer" },
    { "$ref": "#/$defs/commitment" },
    { "$ref": "#/$defs/rejection" },
    { "$ref": "#/$defs/query" },
    { "$ref": "#/$defs/answer" }
  ],
  "$defs": {
    "offer": {
      "description": "Proposes something (time, place, work, exchange). The proposal is the capability's typed field values.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capability", "fields"],
      "properties": {
        "kind": { "const": "offer" },
        "capability": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/capabilityRef" },
        "fields": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/typedFields" }
      }
    },
    "counterOffer": {
      "description": "A new version replacing the open offer. The message it supersedes is the envelope `inReplyTo`; the capability must be the same as in the superseded version.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capability", "fields"],
      "properties": {
        "kind": { "const": "counter-offer" },
        "capability": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/capabilityRef" },
        "fields": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/typedFields" }
      }
    },
    "commitment": {
      "description": "Accepts the offer or counter-offer named by the envelope `inReplyTo` and promises it. Carries no fields: the accepted version's typed fields become the commitment's fields.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "commitment" }
      }
    },
    "rejection": {
      "description": "Rejects the offer or counter-offer named by the envelope `inReplyTo` with a reason code. Any explanation travels only as a note.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "rejection" },
        "reason": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/declineReason" }
      }
    },
    "query": {
      "description": "Asks for information: either the typed parameters of a taxonomy query capability, or a request for person attributes by selective disclosure.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "query" },
        "capability": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/capabilityRef" },
        "fields": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/typedFields" },
        "disclosureRequest": { "$ref": "https://suiss.app/schemas/one/federation/disclosure/v1.json#/$defs/request" }
      },
      "oneOf": [
        { "required": ["capability", "fields"], "not": { "required": ["disclosureRequest"] } },
        { "required": ["disclosureRequest"], "not": { "anyOf": [{ "required": ["capability"] }, { "required": ["fields"] }] } }
      ]
    },
    "answer": {
      "description": "Answers the query named by the envelope `inReplyTo` with the least information: derived typed values of the capability's output schema, or a selective-disclosure presentation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "answer" },
        "capability": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/capabilityRef" },
        "fields": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/typedFields" },
        "presentation": { "$ref": "https://suiss.app/schemas/one/federation/disclosure/v1.json#/$defs/presentation" }
      },
      "oneOf": [
        { "required": ["capability", "fields"], "not": { "required": ["presentation"] } },
        { "required": ["presentation"], "not": { "anyOf": [{ "required": ["capability"] }, { "required": ["fields"] }] } }
      ]
    }
  }
}
