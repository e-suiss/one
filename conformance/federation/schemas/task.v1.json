{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/federation/task/v1.json",
  "title": "One Federation A2A Task projection",
  "description": "Profile of the A2A v1.0 Task that projects one offer chain. The Task is a projection: the canonical state is the Work commitment and its records. Interrupted states map to negotiation waits; terminal states map to the chain's outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "contextId", "status", "metadata"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "contextId": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/correlationId" },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "timestamp"],
      "properties": {
        "state": {
          "enum": [
            "TASK_STATE_SUBMITTED",
            "TASK_STATE_WORKING",
            "TASK_STATE_INPUT_REQUIRED",
            "TASK_STATE_AUTH_REQUIRED",
            "TASK_STATE_COMPLETED",
            "TASK_STATE_REJECTED",
            "TASK_STATE_CANCELED",
            "TASK_STATE_FAILED"
          ]
        },
        "timestamp": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/timestamp" },
        "message": { "$ref": "https://suiss.app/schemas/one/federation/message/v1.json" }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/commitmentArtifact" }
    },
    "history": {
      "type": "array",
      "items": { "$ref": "https://suiss.app/schemas/one/federation/message/v1.json" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["https://suiss.app/a2a/one-federation/v1"],
      "properties": {
        "https://suiss.app/a2a/one-federation/v1": { "$ref": "#/$defs/taskExtension" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "properties": { "state": { "enum": ["TASK_STATE_SUBMITTED", "TASK_STATE_WORKING"] } } } } },
      "then": { "properties": { "metadata": { "properties": { "https://suiss.app/a2a/one-federation/v1": { "properties": { "phase": { "const": "evaluating" } } } } } } }
    },
    {
      "if": { "properties": { "status": { "properties": { "state": { "const": "TASK_STATE_INPUT_REQUIRED" } } } } },
      "then": { "properties": { "metadata": { "properties": { "https://suiss.app/a2a/one-federation/v1": { "properties": { "phase": { "const": "awaiting-counterparty" } } } } } } }
    },
    {
      "if": { "properties": { "status": { "properties": { "state": { "const": "TASK_STATE_AUTH_REQUIRED" } } } } },
      "then": { "properties": { "metadata": { "properties": { "https://suiss.app/a2a/one-federation/v1": { "properties": { "phase": { "const": "awaiting-principal" } } } } } } }
    },
    {
      "if": { "properties": { "status": { "properties": { "state": { "const": "TASK_STATE_COMPLETED" } } } } },
      "then": {
        "required": ["artifacts"],
        "properties": {
          "artifacts": { "minItems": 1 },
          "metadata": { "properties": { "https://suiss.app/a2a/one-federation/v1": { "properties": { "phase": { "const": "committed" } } } } }
        }
      },
      "else": { "not": { "required": ["artifacts"] } }
    },
    {
      "if": { "properties": { "status": { "properties": { "state": { "const": "TASK_STATE_REJECTED" } } } } },
      "then": { "properties": { "metadata": { "properties": { "https://suiss.app/a2a/one-federation/v1": { "properties": { "phase": { "const": "declined" } } } } } } }
    },
    {
      "if": { "properties": { "status": { "properties": { "state": { "const": "TASK_STATE_CANCELED" } } } } },
      "then": { "properties": { "metadata": { "properties": { "https://suiss.app/a2a/one-federation/v1": { "properties": { "phase": { "const": "expired" } } } } } } }
    },
    {
      "if": { "properties": { "status": { "properties": { "state": { "const": "TASK_STATE_FAILED" } } } } },
      "then": {
        "properties": { "metadata": { "properties": { "https://suiss.app/a2a/one-federation/v1": { "properties": { "phase": { "const": "refused" } }, "required": ["refusal"] } } } }
      }
    }
  ],
  "$defs": {
    "taskExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "phase", "offerVersion"],
      "properties": {
        "schemaVersion": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/schemaVersion" },
        "phase": {
          "description": "Negotiation phase. awaiting-counterparty and awaiting-principal are negotiation waits; the reason for awaiting the principal is never shared.",
          "enum": ["evaluating", "awaiting-counterparty", "awaiting-principal", "committed", "declined", "expired", "refused"]
        },
        "offerVersion": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/offerVersion" },
        "expiresAt": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/timestamp" },
        "refusal": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/refusal" }
      }
    },
    "commitmentArtifact": {
      "description": "The Artifact of a completed chain: a reference to the Work commitment the acceptance created. It is not acceptance of the commitment's result.",
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "parts", "extensions"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["data", "mediaType", "metadata"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["correlationId", "workOperation", "acceptedOfferVersion", "acceptedDigest", "commitmentRef"],
                "properties": {
                  "correlationId": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/correlationId" },
                  "workOperation": { "enum": ["promise", "accept-counter"] },
                  "acceptedOfferVersion": { "type": "integer", "minimum": 1 },
                  "acceptedDigest": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/digest" },
                  "commitmentRef": {
                    "description": "Resolvable reference to the Work commitment.",
                    "type": "string",
                    "format": "uri",
                    "maxLength": 1024
                  }
                }
              },
              "mediaType": { "const": "application/json" },
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "required": ["https://suiss.app/a2a/one-federation/v1"],
                "properties": {
                  "https://suiss.app/a2a/one-federation/v1": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["part"],
                    "properties": { "part": { "const": "commitment" } }
                  }
                }
              }
            }
          }
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "https://suiss.app/schemas/one/federation/common/v1.json#/$defs/extensionUri" }
        }
      }
    }
  }
}
