[
  {
    "rule": "SEC-14 (1)",
    "description": "summarising an email keeps external.email",
    "input": {
      "op": "summarise",
      "inputs": [
        {
          "label": "external.email"
        }
      ]
    },
    "expected": {
      "label": "external.email"
    }
  },
  {
    "rule": "SEC-14 (1)",
    "description": "summarising email and web content keeps both sources",
    "input": {
      "op": "summarise",
      "inputs": [
        {
          "label": "external.email"
        },
        {
          "label": "external.web"
        }
      ]
    },
    "expected": {
      "label": "external.mixed",
      "sources": [
        "external.email",
        "external.web"
      ]
    }
  },
