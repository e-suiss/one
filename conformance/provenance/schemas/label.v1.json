{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/provenance/label/v1.json",
  "title": "One internal provenance label",
  "type": "string",
  "anyOf": [
    { "$ref": "#/$defs/trusted" },
    { "$ref": "#/$defs/untrusted" }
  ],
  "$defs": {
    "user": {
      "enum": ["user.direct", "user.memory"]
    },
    "trusted": {
      "enum": ["user.direct", "user.memory", "record.trusted"]
    },
    "external_source": {
      "enum": [
        "external.web",
        "external.email",
        "external.calendar",
        "external.document",
        "external.screen",
        "external.media",
        "external.message",
        "external.one",
        "external.agent",
        "external.tool_description",
        "external.tool_output",
        "external.import",
        "external.app",
        "external.unknown"
      ]
    },
    "external": {
      "anyOf": [
        { "$ref": "#/$defs/external_source" },
        { "const": "external.mixed" }
      ]
    },
    "untrusted": {
      "anyOf": [
        { "const": "one.inferred" },
        { "$ref": "#/$defs/external" }
      ]
    },
    "source": {
      "anyOf": [
        { "$ref": "#/$defs/trusted" },
        { "const": "one.inferred" },
        { "$ref": "#/$defs/external_source" }
      ]
    }
  }
}
