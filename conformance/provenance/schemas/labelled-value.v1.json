{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/provenance/labelled-value/v1.json",
  "title": "Provenance-labelled value",
  "type": "object",
  "required": ["value", "label"],
  "additionalProperties": false,
  "properties": {
    "value": {
      "type": ["string", "number", "integer", "boolean", "object", "array"]
    },
    "label": {
      "$ref": "https://suiss.app/schemas/one/provenance/label/v1.json"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://suiss.app/schemas/one/provenance/label/v1.json#/$defs/source"
      }
    }
  },
  "if": {
    "properties": { "label": { "const": "external.mixed" } },
    "required": ["label"]
  },
  "then": {
    "required": ["sources"],
    "properties": {
      "sources": {
        "contains": {
          "$ref": "https://suiss.app/schemas/one/provenance/label/v1.json#/$defs/external_source"
        },
        "minContains": 2
      }
    }
  }
}
