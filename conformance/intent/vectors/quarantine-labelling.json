              "lines": [
                "Bağdat Caddesi No: 12"
              ],
              "locality": "İstanbul",
              "country": "TR"
            },
            "label": "external.email"
          },
          "rsvp": {
            "kind": "choice",
            "value": "accept",
            "label": "external.email"
          }
        },
        "display_summary": {
