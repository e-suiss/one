              "lines": [
                "Bağdat Caddesi No: 12"
              ],
              "locality": "İstanbul",
              "country": "TR"
            }
          },
          "rsvp": {
            "kind": "choice",
            "value": "accept"
          }
        },
        "display_summary": {
