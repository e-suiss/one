{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/intent/model-context/v1.json",
  "title": "Model context: typed control and marked data parts",
  "oneOf": [
    {
      "$ref": "#/$defs/planner_context"
    },
    {
      "$ref": "#/$defs/quarantine_context"
    }
  ],
  "$defs": {
    "lang": {
      "enum": [
        "tr",
        "en"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "text",
        "lang",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "lang": {
          "$ref": "#/$defs/lang"
        },
        "label": {
          "const": "user.direct"
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/TaskId"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "capabilities",
        "origin_set"
      ],
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "https://suiss.app/schemas/one/intent/capability-ref/v1.json#/$defs/proposed"
          }
        },
        "origin_set": {
          "$ref": "https://suiss.app/schemas/one/intent/origin-set/v1.json"
        }
      }
    },
    "constraint": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "unevaluatedProperties": false,
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "deadline"
            },
            "value": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "budget"
            },
            "value": {
              "$ref": "https://suiss.app/schemas/one/interaction/common/v1.json#/$defs/money"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "read_only"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "reply_language"
            },
            "value": {
              "$ref": "#/$defs/lang"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "max_steps"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      ]
    },
    "planner_control": {
      "type": "object",
      "required": [
        "task",
        "request",
        "scope",
        "constraints"
      ],
      "additionalProperties": false,
      "properties": {
        "task": {
          "$ref": "#/$defs/task"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/constraint"
          }
        }
      }
    },
    "quarantine_control": {
      "type": "object",
      "required": [
        "extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "extraction": {
          "type": "object",
          "required": [
            "schema_id",
            "summary_lang"
          ],
          "additionalProperties": false,
          "properties": {
            "schema_id": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "summary_lang": {
              "anyOf": [
                {
                  "$ref": "#/$defs/lang"
                },
                {
                  "const": "none"
                }
              ]
            }
          }
        }
      }
    },
    "untrusted_data": {
      "type": "object",
      "required": [
        "marking",
        "label",
        "media_type",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "marking": {
          "const": "untrusted_data"
        },
        "label": {
          "$ref": "https://suiss.app/schemas/one/provenance/label/v1.json#/$defs/external"
        },
        "media_type": {
          "const": "text/plain"
        },
        "text": {
          "type": "string",
          "maxLength": 200000
        }
      }
    },
    "memory_data": {
      "type": "object",
      "required": [
        "marking",
        "record_id",
        "label",
        "content_type",
        "epistemic_state",
        "conflicted",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "marking": {
          "const": "memory_data"
        },
        "record_id": {
          "$ref": "https://suiss.app/schemas/one/ontology/id/v1.json#/$defs/MemoryRecordId"
        },
        "label": {
          "const": "user.memory"
        },
        "content_type": {
          "$ref": "https://suiss.app/schemas/one/memory/fields/v1.json#/$defs/content_type"
        },
        "epistemic_state": {
          "allOf": [
            {
              "$ref": "https://suiss.app/schemas/one/memory/fields/v1.json#/$defs/epistemic_state"
            },
            {
              "enum": [
                "stated",
                "verified"
              ]
            }
          ]
        },
        "conflicted": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "trusted_record": {
      "type": "object",
      "required": [
        "marking",
        "record",
        "label",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "marking": {
          "const": "trusted_record"
        },
        "record": {
          "description": "The Access or Work record the fields come from",
          "oneOf": [
            {
              "$ref": "https://suiss.app/schemas/one/ontology/reference/v1.json#/$defs/AccessObjectRef"
            },
            {
              "$ref": "https://suiss.app/schemas/one/ontology/reference/v1.json#/$defs/WorkObjectRef"
            }
          ]
        },
        "label": {
          "const": "record.trusted"
        },
        "fields": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "variable_ref": {
      "type": "object",
      "required": [
        "marking",
        "ref",
        "kind",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "marking": {
          "const": "variable_ref"
        },
        "ref": {
          "$ref": "https://suiss.app/schemas/one/intent/intent-model-output/v1.json#/$defs/variable_ref"
        },
        "kind": {
          "enum": [
            "date",
            "date_time",
            "amount",
            "integer",
            "boolean",
            "name",
            "email",
            "phone",
            "url",
            "address",
            "choice",
            "choice_list"
          ]
        },
        "label": {
          "$ref": "https://suiss.app/schemas/one/provenance/label/v1.json"
        }
      }
    },
    "planner_context": {
      "type": "object",
      "required": [
        "role",
        "control",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "planner"
        },
        "control": {
          "$ref": "#/$defs/planner_control"
        },
        "data": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/memory_data"
              },
              {
                "$ref": "#/$defs/trusted_record"
              },
              {
                "$ref": "#/$defs/variable_ref"
              }
            ]
          }
        }
      }
    },
    "quarantine_context": {
      "type": "object",
      "required": [
        "role",
        "control",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "quarantine"
        },
        "control": {
          "$ref": "#/$defs/quarantine_control"
        },
        "data": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/untrusted_data"
          }
        }
      }
    }
  }
}
