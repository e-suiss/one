{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/intent/quarantine-output/v1.json",
  "title": "Labelled quarantine output",
  "type": "object",
  "required": ["label", "fields"],
  "additionalProperties": false,
  "allOf": [{ "$ref": "#/$defs/mixed_sources" }],
  "properties": {
    "label": { "$ref": "#/$defs/external_label" },
    "sources": { "$ref": "#/$defs/sources" },
    "fields": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "https://suiss.app/schemas/one/intent/quarantine-model-output/v1.json#/$defs/field_name"
      },
      "additionalProperties": {
        "$ref": "https://suiss.app/schemas/one/intent/quarantine-model-output/v1.json#/$defs/typed_field",
        "required": ["label"],
        "allOf": [{ "$ref": "#/$defs/mixed_sources" }],
        "properties": {
          "label": { "$ref": "#/$defs/external_label" },
          "sources": { "$ref": "#/$defs/sources" }
        },
        "unevaluatedProperties": false
      }
    },
    "display_summary": {
      "type": "object",
      "required": ["text", "lang", "label", "display_only"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/mixed_sources" }],
      "properties": {
        "text": {
          "$ref": "https://suiss.app/schemas/one/intent/quarantine-model-output/v1.json#/$defs/summary_text"
        },
        "lang": {
          "$ref": "https://suiss.app/schemas/one/intent/quarantine-model-output/v1.json#/$defs/lang"
        },
        "label": { "$ref": "#/$defs/external_label" },
        "sources": { "$ref": "#/$defs/sources" },
        "display_only": { "const": true }
      }
    }
  },
  "$defs": {
    "external_label": {
      "$ref": "https://suiss.app/schemas/one/provenance/label/v1.json#/$defs/external"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "https://suiss.app/schemas/one/provenance/label/v1.json#/$defs/external_source"
      },
      "description": "Where an external.mixed label came from: two or more distinct external sources, as in labelled-value/v1"
    },
    "mixed_sources": {
      "description": "external.mixed carries its sources; every other label carries none",
      "if": {
        "properties": { "label": { "const": "external.mixed" } },
        "required": ["label"]
      },
      "then": { "required": ["sources"] },
      "else": { "not": { "required": ["sources"] } }
    }
  }
}
