{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/intent/origin-set/v1.json",
  "title": "Per-task read and write origin set",
  "type": "object",
  "required": ["read", "write"],
  "additionalProperties": false,
  "properties": {
    "read": { "$ref": "#/$defs/origins" },
    "write": { "$ref": "#/$defs/origins" }
  },
  "$defs": {
    "origin": {
      "type": "string",
      "maxLength": 262,
      "description": "A canonical https origin: lower-case host, a port from 1 to 65535 other than the default 443, no path, query, fragment or user information",
      "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(:([1-9]|[1-9][0-9]|[1-35-9][0-9]{2}|4[0-35-9][0-9]|44[0-24-9]|[1-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
    },
    "origins": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/origin" }
    }
  }
}
