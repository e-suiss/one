{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/intent/origin-set/v1.json",
  "title": "Per-task read and write origin set",
  "type": "object",
  "required": ["read", "write"],
  "additionalProperties": false,
  "properties": {
    "read": { "$ref": "#/$defs/origins" },
    "write": { "$ref": "#/$defs/origins" }
  },
  "$defs": {
    "origin": {
      "type": "string",
      "maxLength": 262,
      "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(:[1-9][0-9]{0,4})?$"
    },
    "origins": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/origin" }
    }
  }
}
