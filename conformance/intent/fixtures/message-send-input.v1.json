{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suiss.app/schemas/one/intent/fixture/message-send-input/v1.json",
  "title": "Fixture capability input: app.suiss.fixture.message.send v1",
  "type": "object",
  "required": [
    "recipient",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "recipient": {
      "type": "string",
      "format": "email",
      "maxLength": 254,
      "pattern": "^[^\\s@]+@[^\\s@]+$"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "send_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
