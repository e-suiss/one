[
  {
    "rule": "AT-42",
    "description": "A non-urgent approval request is action_required with an explicit next_break",
    "input": {
      "output_type": "app.suiss.one.output.approval.request",
      "interruption": "time-sensitive",
      "urgent": false,
      "critical_grant": false,
      "personal_agent_registered": true
    },
    "expected": {
      "send": true,
      "relay_class": "action_required",
      "interruption": "time-sensitive",
      "timing": "next_break",
      "max_defer_required": true
    }
  },
  {
    "rule": "AT-42",
    "description": "An urgent approval request is action_required and immediate",
    "input": {
      "output_type": "app.suiss.one.output.approval.request",
