      },
      "event": "candidate",
      "version": "a3",
      "gates": {
        "personality": true,
        "held_out": true,
        "safety": true
      }
    },
    "expected": {
      "active": "a3",
      "previous": "a2",
      "shredded": [
        "a1"
      ],
      "outcome": "activated"
    }
  },
  {
