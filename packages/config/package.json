{
  "name": "@esuiss/one-config",
  "version": "0.0.0",
  "private": true,
  "description": "The one shared TypeScript, ESLint and Prettier configuration that every One TypeScript package extends.",
  "type": "module",
  "files": [
    "eslint.config.js",
    "prettier.config.js",
    "tsconfig.base.json"
  ],
  "exports": {
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js",
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.12.0",
    "typescript-eslint": "8.71.0"
  },
  "peerDependencies": {
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
